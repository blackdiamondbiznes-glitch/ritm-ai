BOT_TOKEN=123456789:replace-with-your-token
DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/engagement
SUPER_ADMIN_IDS=111111111
TRIAL_DAYS=5
PENDING_TTL_HOURS=24
THROTTLE_SECONDS=0.5
DEFAULT_TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT=120
JOB_TICK_SECONDS=30
SEND_GAP_SECONDS=0.05
ADMIN_POST_MIN_CHARS=200
ADMIN_POST_QUIZ_DELAY_SECONDS=600
POINTS_PER_CORRECT_ANSWER=10
LEADERBOARD_ANNOUNCE_TIME=09:00
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_CARD_TYPE=
PAYMENT_CARD2_NUMBER=
PAYMENT_CARD2_HOLDER=
PAYMENT_CARD2_TYPE=
FOUNDER_SLOTS=20
PERIOD_DISCOUNTS=3:7,12:15
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_ENABLED=true
BACKUP_TIME=04:00
BACKUP_MAX_MB=45
ALERT_COOLDOWN_SECONDS=300
HEALTH_PORT=8080
HEALTH_FILE=/tmp/ritm-health
HEALTH_STALE_SECONDS=120

WEBAPP_PORT=8081
WEBAPP_URL=
WEBAPP_CORS_ORIGINS=
WEBAPP_AUTH_MAX_AGE=86400
WEBAPP_SESSION_TTL=43200
WEBAPP_SESSION_SECRET=
# Payment trust rules (see docs/payments-trust.md)
PAYMENT_TERMS_VERSION=2026-11-v1
PAYMENT_REVIEW_HOURS=12
PAYMENT_DRAFT_TTL_HOURS=24
PAYMENT_FAKE_BLOCK_AFTER=2

# Telegram username shown as "Qo'llab-quvvatlash" in the Mini App (no @). Empty hides it.
SUPPORT_USERNAME=

# Telegram updates: polling (local Docker), webhook (Render), off (staging: Mini App only,
# no updates and no scheduled jobs). Webhook URL = <WEBHOOK_BASE_URL|WEBAPP_URL|RENDER_EXTERNAL_URL>/tg/<secret>
TELEGRAM_MODE=polling
WEBHOOK_BASE_URL=
# Optional; letters, digits, _ and -. Empty = derived from BOT_TOKEN.
WEBHOOK_SECRET=
